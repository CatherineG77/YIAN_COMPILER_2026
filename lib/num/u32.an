from std.core.hash import Murmur3Hasher, Hash
from std.core.slice import from_raw_parts
from std.core.string import String

impl u32 {
    pub String to_string_radix(u64 radix) {
        if radix < 2 or radix > 36 {
            panic("radix must be between 2 and 36")
        }
        if *self == 0 {
            return String.from("0")
        }

        u64 n = u64(*self)
        String digits = String.from("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ")
        String out = String.new()
        while n > 0 {
            u64 digit = n % radix
            out += char(digits.as_slice()[digit])
            n /= radix
        }
        return out.chars().rev().collect()
    }
}

impl Hash<Murmur3Hasher> for u32 {
    hash(Murmur3Hasher hasher) {
        u32 val = *self
        u8* ptr = bitcast<u8*>(&val)
        hasher.write(from_raw_parts(ptr, 4))
    }
}
