// Focus: struct and struct constructor

struct Point {
    i32 x
    i32 y
}

struct Rect {
    Point origin
    i32 w
    i32 h
}

i32 min_i32(i32 a, i32 b) {
    if a < b {
        return a;
    } else {
        return b;
    }
}

i32 max_i32(i32 a, i32 b) {
    if a > b {
        return a;
    } else {
        return b;
    }
}

Point translate(Point p, i32 dx, i32 dy) {
    return Point(p.x + dx, p.y + dy);
}

Rect scale(Rect r, i32 sx, i32 sy) {
    return Rect(r.origin, r.w * sx, r.h * sy);
}

i32 area(Rect r) {
    return r.w * r.h;
}

bool contains(Rect r, Point p) {
    return p.x >= r.origin.x and p.x < r.origin.x + r.w and p.y >= r.origin.y and p.y < r.origin.y + r.h;
}

Rect union_rect(Rect a, Rect b) {
    let min_x: i32 = min_i32(a.origin.x, b.origin.x);
    let min_y: i32 = min_i32(a.origin.y, b.origin.y);
    let max_x: i32 = max_i32(a.origin.x + a.w, b.origin.x + b.w);
    let max_y: i32 = max_i32(a.origin.y + a.h, b.origin.y + b.h);
    return Rect(Point(min_x, min_y), max_x - min_x, max_y - min_y);
}

i32 main() {
    let p: Point = Point(2, 3);
    let r1: Rect = Rect(Point(1, 1), 3, 4);
    let r2: Rect = Rect(Point(3, 4), 4, 3);

    let t: Point = translate(p, 1, -1);        // (3,2)
    let r1s: Rect = scale(r1, 2, 1);           // w=6, h=4 -> area=24
    let u: Rect = union_rect(r1, r2);          // bounding box -> area expected 36

    if area(r1) == 12 and area(r1s) == 24 and area(u) == 36 and contains(u, t) and not contains(r1, Point(5,5)) {
        return 0;
    } else {
        return 1;
    }
}