from std.core.vec import Vec
from std.core.string import String
from std.core.option import Option

from ast import Pattern
from expr import BinaryOp, UnaryOp, Literal
from type import StructField, EnumVariant

pub struct HProgram {
    pub Vec<HFuncDef> funcs
}

pub struct HFuncDef {
    pub u64 type_id
    pub Vec<HStmt> body
    pub Vec<u64> local_vars
}

pub enum HStmt {
    ExprStmt { HExpr expr }
    Delete { HExpr target }
    Return { Option<HExpr> value }

    If {
        HExpr condition
        Vec<HStmt> then_branch
        Option<Vec<HStmt>> else_branch
    }
    Loop {
        Vec<HStmt> body
    }
    Match {
        HExpr value
        Vec<(Pattern, Vec<HStmt>)> arms
    }

    Break, Continue
}

pub struct HExpr {
    pub HExprKind kind
    pub bool is_lvalue
    pub u64 type_id
}

pub enum HExprKind {
    Lit { Literal lit }
    Var { u64 var_symbol_id }
    Binary {
        HExpr* left
        BinaryOp op
        HExpr* right
    }
    Unary {
        UnaryOp op
        HExpr* operand
    }
    Call {
        u64 func_symbol_id
        Vec<HExpr> args
    }
    Construct {
        u64 struct_type_id
        Vec<HExpr> field_values
    }
    FieldAccess {
        HExpr* base
        StructField field
    }
    VariantAccess {
        u64 enum_type_id
        EnumVariant variant
    }
    Dyn {
        u64 type_id
        Option<HExpr*> array_size
    }
}
// ===== Implement Formatting =====

String prefix_hir(Vec<bool>* guides, bool is_last) {
    String out = String.new()
    for has_next in *guides {
        if has_next {
            out += "│   "
        } else {
            out += "    "
        }
    }
    if is_last {
        out += "└── "
    } else {
        out += "├── "
    }
    return out
}

String export_hir_items<T>(Vec<T> items, Vec<bool>* guides) {
    String out = String.new()
    for i in 0..items.len() {
        if i != items.len() - 1 {
            out += items[i].export(guides, false)
        } else {
            out += items[i].export(guides, true)
        }
    }
    return out
}

impl HProgram {
    pub String export() {
        String out = String.from("HProgram\n")
        Vec<bool> guides = Vec<bool>.new()
        out += export_hir_items(self.funcs, &guides)
        return out
    }
}

impl HFuncDef {
    pub String export(Vec<bool>* guides, bool is_last) {
        String out = prefix_hir(guides, is_last)
        out += "HFuncDef: type_id = "
        out += self.type_id.to_string()
        out += "\n"

        guides.push(not is_last)

        if self.local_vars.len() > 0 {
            out += prefix_hir(guides, false) + "LocalVars: "
            for i in 0..self.local_vars.len() {
                out += self.local_vars[i].to_string()
                if i != self.local_vars.len() - 1 {
                    out += ", "
                }
            }
            out += "\n"
        }

        out += export_hir_items(self.body, guides)

        guides.pop()
        return out
    }
}

impl HStmt {
    pub String export(Vec<bool>* guides, bool is_last) {
        String out = prefix_hir(guides, is_last)
        
        match *self {
            ExprStmt as e {
                out += "ExprStmt:\n"
                guides.push(not is_last)
                out += e.expr.export(guides, true)
                guides.pop()
            }
            Delete as d {
                out += "Delete:\n"
                guides.push(not is_last)
                out += d.target.export(guides, true)
                guides.pop()
            }
            Return as r {
                out += "Return"
                guides.push(not is_last)
                
                if r.value.is_some() {
                    out += ":\n"
                    out += prefix_hir(guides, true) + "Value:\n"

                    guides.push(false)
                    out += r.value.unwrap().export(guides, true)
                    guides.pop()
                } else {
                    out += "\n"
                }
                
                guides.pop()
            }
            If as i {
                out += "If:\n"
                guides.push(not is_last)

                bool has_else = i.else_branch.is_some()

                // export condition
                out += prefix_hir(guides, false) + "Condition:\n"

                guides.push(true)
                out += i.condition.export(guides, true)
                guides.pop()

                // export then branch
                out += prefix_hir(guides, not has_else) + "Then:\n"

                guides.push(has_else)
                out += export_hir_items(i.then_branch, guides)
                guides.pop()

                // export else branch
                if has_else {
                    out += prefix_hir(guides, true) + "Else:\n"

                    guides.push(false)
                    out += export_hir_items(i.else_branch.unwrap(), guides)
                    guides.pop()
                }

                guides.pop()
            }
            Loop as l {
                out += "Loop:\n"
                guides.push(not is_last)

                // export body
                out += prefix_hir(guides, true) + "Body:\n"
                guides.push(false)
                out += export_hir_items(l.body, guides)
                guides.pop()

                guides.pop()
            }
            Match as m {
                out += "Match:\n"
                guides.push(not is_last)

                // export value
                out += prefix_hir(guides, false) + "Value:\n"

                guides.push(true)
                out += m.value.export(guides, true)
                guides.pop()

                // export arms
                out += prefix_hir(guides, true) + "Arms:\n"

                guides.push(false)

                for idx in 0..m.arms.len() {
                    bool arm_is_last = idx == m.arms.len() - 1
                    out += prefix_hir(guides, arm_is_last) + "Arm: " + m.arms[idx][0].to_string() + "\n"

                    guides.push(not arm_is_last)
                    out += export_hir_items(m.arms[idx][1], guides)
                    guides.pop()
                }

                guides.pop()

                guides.pop()
            }
            Break { out += "Break\n" }
            Continue { out += "Continue\n" }
        }

        return out
    }
}

impl HExpr {
    pub String export(Vec<bool>* guides, bool is_last) {
        String out = prefix_hir(guides, is_last)
        out += String.from("HExpr: type_id = ") + self.type_id.to_string() + ", lvalue = " + self.is_lvalue.to_string() + "\n"
        
        guides.push(not is_last)
        out += self.kind.export(guides, true)
        guides.pop()
        
        return out
    }
}

impl HExprKind {
    pub String export(Vec<bool>* guides, bool is_last) {
        String out = prefix_hir(guides, is_last)
        guides.push(not is_last)
        
        match *self {
            Lit as l {
                out += "Literal: "
                out += l.lit.to_string()
                out += "\n"
            }
            Var as v {
                out += "Var: var_symbol_id = "
                out += v.var_symbol_id.to_string()
                out += "\n"
            }
            Binary as b {
                out += "BinaryOp: "
                out += b.op.to_string()
                out += "\n"
                out += b.left.export(guides, false)
                out += b.right.export(guides, true)
            }
            Unary as u {
                out += "UnaryOp: "
                out += u.op.to_string()
                out += "\n"
                out += u.operand.export(guides, true)
            }
            Call as c {
                out += "Call: func_symbol_id = "
                out += c.func_symbol_id.to_string()
                out += "\n"
                out += export_hir_items(c.args, guides)
            }
            Construct as c {
                out += "Construct: struct_type_id = "
                out += c.struct_type_id.to_string()
                out += "\n"
                out += export_hir_items(c.field_values, guides)
            }
            FieldAccess as f {
                out += "FieldAccess: type_id = "
                out += f.field.type_id.to_string()
                out += ", orig_name = "
                out += f.field.name
                out += "\n"
                out += f.base.export(guides, true)
            }
            VariantAccess as v {
                out += "VariantAccess: enum_type_id = "
                out += v.enum_type_id.to_string()
                out += ", orig_name = "
                out += v.variant.name
                out += "\n"
            }
            Dyn as d {
                out += "Dyn: type_id = "
                out += d.type_id.to_string()
                out += "\n"
                if d.array_size.is_some() {
                    out += d.array_size.unwrap().export(guides, true)
                }
            }
        }
        
        guides.pop()
        return out
    }
}
